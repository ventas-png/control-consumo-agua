# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# EmailJS
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_TEMPLATE_RECIBO=your-receipt-template-id
VITE_EMAILJS_TEMPLATE_PASSWORD_RESET=your-password-reset-template-id
VITE_EMAILJS_TEMPLATE_RUTA_ASIGNADA=your-ruta-template-id
VITE_EMAILJS_TEMPLATE_DIFUSION=your-difusion-template-id

# App config
VITE_COUNTRY_CODE=502

# URL pública del sitio (usar en Supabase → Auth → URL Configuration)
# Ejemplo local:    http://localhost:5173
# Ejemplo Vercel:   https://tu-proyecto.vercel.app
VITE_APP_URL=https://tu-proyecto.vercel.app

# ─── CORS de Edge Functions (Supabase → Edge Functions → Secrets) ───────────
# Las Edge Functions (p. ej. create-user) validan el "origin" del navegador.
# Si el dominio de producción no está permitido, el navegador bloquea la
# respuesta y la app muestra "Error de conexión" al crear usuarios.
# Los dominios de producción (administratodo.com / .app) ya están permitidos
# por defecto en el código. Para dominios adicionales, configura en Supabase
# (NO es una variable VITE):
#   ALLOWED_ORIGINS=https://otro-dominio.com,http://localhost:5173
# Como respaldo, las funciones también permiten el origen del secret APP_URL.

# ─── Google OAuth para envío de correos (Gmail API) ─────────────────────────
# Crea un proyecto en https://console.cloud.google.com/
# 1. Habilita la API "Gmail API"
# 2. Crea credenciales OAuth 2.0 (tipo: Aplicación web)
# 3. Agrega URI de redirección autorizada: https://tu-proyecto.vercel.app/
# 4. Configura el Client ID y el Secret en Supabase → Edge Functions → Secrets
#    (NO son variables VITE; el navegador nunca los usa directamente):
#      GOOGLE_CLIENT_ID=...
#      GOOGLE_CLIENT_SECRET=...
#      APP_URL=https://tu-proyecto.vercel.app
