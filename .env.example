# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# EmailJS
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_TEMPLATE_RECIBO=your-receipt-template-id
VITE_EMAILJS_TEMPLATE_PASSWORD_RESET=your-password-reset-template-id
VITE_EMAILJS_TEMPLATE_RUTA_ASIGNADA=your-ruta-template-id
VITE_EMAILJS_TEMPLATE_DIFUSION=your-difusion-template-id

# App config
VITE_COUNTRY_CODE=502

# URL pública del sitio (usar en Supabase → Auth → URL Configuration)
# Ejemplo local:    http://localhost:5173
# Ejemplo Vercel:   https://tu-proyecto.vercel.app
VITE_APP_URL=https://tu-proyecto.vercel.app

# ─── Google OAuth para envío de correos (Gmail API) ─────────────────────────
# Crea un proyecto en https://console.cloud.google.com/
# 1. Habilita la API "Gmail API"
# 2. Crea credenciales OAuth 2.0 (tipo: Aplicación web)
# 3. Agrega URI de redirección autorizada: https://tu-proyecto.vercel.app/
# 4. Copia el Client ID y Client Secret aquí
# 5. Configura también en Supabase → Edge Functions → Secrets:
#      GOOGLE_CLIENT_ID=...
#      GOOGLE_CLIENT_SECRET=...
#      APP_URL=https://tu-proyecto.vercel.app
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
