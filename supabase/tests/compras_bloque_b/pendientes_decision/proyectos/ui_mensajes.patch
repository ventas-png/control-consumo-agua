+// elegido «Empresa» (hallazgo V2-B1 de la segunda verificación independiente).
+describe('elegir «Empresa» a propósito se recuerda; sin elección recordada se preselecciona el primer proyecto', () => {
+  const llave = 'conta-ledger:c1'
