+// Con qué contabilidad abre Contabilidad: ver ledgerInicialPorAlcance (D-8 del alcance de proyecto al capturar).
+import { describe, expect, it } from 'vitest'
+import { ledgerInicialPorAlcance } from '../proyectosAccess'
+
+const A = { id: 'proyecto-a' }
+const B = { id: 'proyecto-b' }
+
+describe('ledgerInicialPorAlcance', () => {
+  it('una contabilidad recordada se respeta, sea quien sea', () => {
+    expect(ledgerInicialPorAlcance({ exento: false, guardado: 'proyecto-b', accesibles: [A, B] })).toBe('proyecto-b')
+    expect(ledgerInicialPorAlcance({ exento: true, guardado: 'proyecto-b', accesibles: [A, B] })).toBe('proyecto-b')
+  })
+
+  it('la persona exenta, sin contabilidad recordada, conserva «Empresa» (null)', () => {
+    expect(ledgerInicialPorAlcance({ exento: true, guardado: null, accesibles: [A, B] })).toBeNull()
+  })
+
+  it('la persona acotada, sin contabilidad recordada, abre el PRIMER proyecto que ve', () => {
+    expect(ledgerInicialPorAlcance({ exento: false, guardado: null, accesibles: [A, B] })).toBe('proyecto-a')
+  })
+
+  it('la persona acotada que no ve ningún proyecto queda en «Empresa» (null): no hay otra contabilidad', () => {
+    expect(ledgerInicialPorAlcance({ exento: false, guardado: null, accesibles: [] })).toBeNull()
+  })
+
+  it('«Empresa» elegida a propósito (empresaElegida) se respeta también para la persona acotada: no se le preselecciona un proyecto', () => {
+    expect(ledgerInicialPorAlcance({ exento: false, guardado: null, empresaElegida: true, accesibles: [A, B] })).toBeNull()
+    expect(ledgerInicialPorAlcance({ exento: true, guardado: null, empresaElegida: true, accesibles: [A, B] })).toBeNull()
+  })
+
+  it('sin «Empresa» elegida (false o ausente) la persona acotada abre el primer proyecto', () => {
+    expect(ledgerInicialPorAlcance({ exento: false, guardado: null, empresaElegida: false, accesibles: [A, B] })).toBe('proyecto-a')
+  })
+})
