 -- ════════════════════════════════════════════════════════════════════════════
--- REVERSIÓN DE LAS MIGRACIONES 20261027000000…0900 (compras · controles de servidor)
+-- REVERSIÓN DE LAS MIGRACIONES 20261027000000…0900 Y 20261027001000 (compras · controles de servidor y alcance de proyecto al capturar)
--- GENERADO del catálogo de una cadena real de migraciones (no se edita a mano): cada sección deshace UNA migración
+-- GENERADO del catálogo de una cadena real de migraciones (no se edita a mano), SALVO la sección de 20261027001000, que está escrita a mano: cada sección deshace UNA migración
 -- y supone que las posteriores ya están revertidas (por eso van de la última a la primera).
+-- La sección de 20261027001000 (alcance de proyecto al capturar: 3 funciones y 9 disparadores que LLAMAN a compras_sesion_usuario(), de 20261027000300)
+-- va ENCIMA de todas, porque se revierte la primera: si se revirtiera la serie sin ella, la función desaparecería con los 9 disparadores
+-- vivos y TODA inserción en las nueve tablas de compras fallaría (function public.compras_sesion_usuario() does not exist). Es idempotente
+-- y no hace nada si esa migración no se aplicó.
 -- Cada bloque es una transacción: si algo falla, no queda nada a medias. Son funciones, disparadores, índices, restricciones y políticas
 -- (y, en 0900, la tabla de la bitácora de la separación y los privilegios de compras_config); NO hay datos de negocio que borrar ni restaurar
 -- (salvo las claves de idempotencia de 0800; la bitácora de la separación se CONSERVA si tiene cambios).
 -- Revertir REABRE los defectos que cada migración cerraba. Verificado con 
--- supabase/tests/compras_bloque_b/run.sh §6c (aplica la cadena, revierte TODO y revierte SOLO la sección de 0900; compara el catálogo).
+-- supabase/tests/compras_bloque_b/run.sh §6c (aplica la cadena, revierte TODO, revierte SOLO la sección de 20261027001000 y revierte las secciones
+-- de 20261027001000 + 0900 en ese orden; compara el catálogo en cada caso).
 -- La sección de 20261027000900 está escrita con sus tres piezas (facturas, separación, permisos) y se puede correr SOLA para volver al
 -- estado posterior a 0800. La bitácora de la separación se conserva si tiene cambios (ver su aviso).
 -- ════════════════════════════════════════════════════════════════════════════
 
+-- ── 20261027001000_compras_alcance_proyecto_captura ───────────────────────
+BEGIN;
+SET LOCAL lock_timeout = '10s';
+SET LOCAL statement_timeout = '120s';
+-- Quita lo que añade la migración y SOLO eso: 9 disparadores (5 de captura, 4 de las hijas) y 3 funciones. No toca datos, ni la 0900
+-- (trg_zzcompras_mover_alcance y compras_exigir_permiso quedan como están), ni privilegios, ni políticas. Idempotente; sin pérdida de datos:
+-- los documentos y renglones creados mientras estuvo puesta se conservan tal cual. REABRE la brecha (una persona acotada vuelve a poder insertar
+-- borradores en proyectos que no tiene, insertar o mover documentos de/hacia «sin proyecto» y agregar renglones a borradores ajenos).
+-- DROP TRIGGER toma ACCESS EXCLUSIVE en cada una de las 9 tablas hasta el final de la transacción: con lock_timeout = 10 s falla entera si una
+-- está ocupada y se reintenta; correrla fuera de pagos y aprobaciones.
+DROP TRIGGER IF EXISTS trg_zzzcompras_alcance_captura ON public.ordenes_compra;
+DROP TRIGGER IF EXISTS trg_zzzcompras_alcance_captura ON public.recepciones;
+DROP TRIGGER IF EXISTS trg_zzzcompras_alcance_captura ON public.facturas_proveedor;
+DROP TRIGGER IF EXISTS trg_zzzcompras_alcance_captura ON public.ordenes_pago;
+DROP TRIGGER IF EXISTS trg_zzzcompras_alcance_captura ON public.contrasenas_pago;
+
+DROP TRIGGER IF EXISTS trg_zzzcompras_alcance_hija ON public.orden_compra_lineas;
+DROP TRIGGER IF EXISTS trg_zzzcompras_alcance_hija ON public.recepcion_lineas;
+DROP TRIGGER IF EXISTS trg_zzzcompras_alcance_hija ON public.factura_proveedor_lineas;
+DROP TRIGGER IF EXISTS trg_zzzcompras_alcance_hija ON public.contrasena_pago_facturas;
+
+DROP FUNCTION IF EXISTS public.compras_tg_alcance_captura();
+DROP FUNCTION IF EXISTS public.compras_tg_alcance_hija();
+DROP FUNCTION IF EXISTS public.compras_puede_destinar_proyecto(uuid);
+
+DO $reversion_1000$
+BEGIN
+  IF EXISTS (SELECT 1 FROM pg_trigger t WHERE NOT t.tgisinternal AND t.tgname IN ('trg_zzzcompras_alcance_captura', 'trg_zzzcompras_alcance_hija'))
+     OR to_regprocedure('public.compras_tg_alcance_captura()') IS NOT NULL
+     OR to_regprocedure('public.compras_tg_alcance_hija()') IS NOT NULL
+     OR to_regprocedure('public.compras_puede_destinar_proyecto(uuid)') IS NOT NULL THEN
+    RAISE EXCEPTION 'COMPRAS_REVERSION: quedó algo del alcance de proyecto al capturar (20261027001000); se revierte toda la transacción.' USING ERRCODE = 'internal_error';
+  END IF;
+END
+$reversion_1000$;
+COMMIT;
+
 -- ── 20261027000900_compras_permisos_accion_separacion_y_numeros_factura ────
 BEGIN;
