{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    ":timezone(America/Guatemala)"
  ],
  "schedule": ["before 8am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate · Dashboard de dependencias",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": false,
      "groupName": "minor & patch (no-major)"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "groupName": "major updates",
      "labels": ["dependencies", "major-upgrade"],
      "schedule": ["before 8am on the first day of the month"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "devDependencies (minor/patch)"
    },
    {
      "matchPackageNames": ["@supabase/supabase-js"],
      "groupName": "supabase",
      "labels": ["dependencies", "supabase"]
    },
    {
      "matchPackageNames": ["@sentry/react", "@sentry/vite-plugin", "posthog-js"],
      "groupName": "observability",
      "labels": ["dependencies", "observability"]
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react",
      "labels": ["dependencies", "react"]
    },
    {
      "matchPackageNames": ["vite", "@vitejs/plugin-react", "vitest", "@vitest/coverage-v8"],
      "groupName": "vite & vitest",
      "labels": ["dependencies", "build"]
    },
    {
      "matchPackageNames": ["jspdf", "jspdf-autotable", "exceljs", "chart.js"],
      "groupName": "documents & charts",
      "labels": ["dependencies"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 8am on the first day of the month"]
  },
  "ignoreDeps": []
}
